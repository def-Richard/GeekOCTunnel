diff --git a/tun-win32.c b/tun-win32.c
index 113024c..6b9acef 100644
--- a/tun-win32.c
+++ b/tun-win32.c
@@ -888,7 +888,7 @@ int os_read_tun(struct openconnect_info *vpninfo, struct pkt *pkt)
 
 		if (err == ERROR_IO_PENDING)
 			vpninfo->tun_rd_pending = 1;
-		else if (err == ERROR_OPERATION_ABORTED) {
+		else if (err == ERROR_OPERATION_ABORTED || err == ERROR_BROKEN_PIPE || err == ERROR_PIPE_NOT_CONNECTED) {
 			vpninfo->quit_reason = "TAP device aborted";
 			vpn_progress(vpninfo, PRG_ERR,
 				     _("TAP device aborted connectivity. Disconnecting.\n"));
@@ -907,6 +907,11 @@ int os_read_tun(struct openconnect_info *vpninfo, struct pkt *pkt)
 		DWORD err = GetLastError();
 
 		if (err != ERROR_IO_INCOMPLETE) {
+			if (err == ERROR_BROKEN_PIPE || err == ERROR_PIPE_NOT_CONNECTED || err == ERROR_OPERATION_ABORTED) {
+				vpninfo->tun_rd_pending = 0;
+				vpninfo->quit_reason = "Tunnel transport closed";
+				return -1;
+			}
 			char *errstr = openconnect__win32_strerror(err);
 			vpninfo->tun_rd_pending = 0;
 			vpn_progress(vpninfo, PRG_ERR,
@@ -974,6 +979,12 @@ static void shutdown_tun(struct openconnect_info *vpninfo)
 		return;
 	}
 
+	CancelIoEx(vpninfo->tun_fh, NULL);
+	if (vpninfo->tun_rd_pending) {
+		DWORD ignored;
+		GetOverlappedResult(vpninfo->tun_fh, &vpninfo->tun_rd_overlap, &ignored, TRUE);
+		vpninfo->tun_rd_pending = 0;
+	}
 	CloseHandle(vpninfo->tun_fh);
 	vpninfo->tun_fh = NULL;
 	CloseHandle(vpninfo->tun_rd_overlap.hEvent);
@@ -988,6 +999,18 @@ int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, intptr_t tun_fd)
 	if (vpninfo->wintun)
 		return setup_wintun_fd(vpninfo, tun_fd);
 
+	/* A local message pipe transports one raw IP packet per message to our
+	 * separately authorized Wintun helper. Never accept byte-stream pipes. */
+	if (GetFileType((HANDLE)tun_fd) == FILE_TYPE_PIPE) {
+		DWORD flags, mode;
+		if (!GetNamedPipeInfo((HANDLE)tun_fd, &flags, NULL, NULL, NULL) ||
+		    !(flags & PIPE_TYPE_MESSAGE) ||
+		    !GetNamedPipeHandleState((HANDLE)tun_fd, &mode, NULL, NULL, NULL, NULL, 0) ||
+		    !(mode & PIPE_READMODE_MESSAGE))
+			return -EINVAL;
+		goto attach_handle;
+	}
+
 	/* Toggle media status so that network location awareness picks up all the configuration
 	   that occurred and properly assigns the network so the user can adjust firewall
 	   settings. */
@@ -1003,8 +1026,11 @@ int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, intptr_t tun_fd)
 		}
 	}
 
-	vpninfo->tun_fh = (HANDLE)tun_fd;
+attach_handle:
 	vpninfo->tun_rd_overlap.hEvent = CreateEvent(NULL, FALSE, FALSE, NULL);
+	if (!vpninfo->tun_rd_overlap.hEvent)
+		return -EIO;
+	vpninfo->tun_fh = (HANDLE)tun_fd;
 	monitor_read_fd(vpninfo, tun);
 
 	return 0;
